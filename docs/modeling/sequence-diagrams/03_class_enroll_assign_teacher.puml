@startuml 03_class_enroll_assign_teacher
/'
MÔ TẢ SƠ ĐỒ
Mục tiêu: Luồng nghiệp vụ Gán Học sinh vào Lớp và Chọn Giáo viên giảng dạy.
Phạm vi: Cập nhật dữ liệu sĩ số và ràng buộc liên kết (Relationships) từ Class tới Student và Teacher.
Assumptions:
- Sĩ số lớp bị giới hạn (max_capacity dựa vào Room hoặc config Lớp).
- Admin thực hiện quá trình gán (assign).
'/

title Sequence Diagram - 03. Class Enroll & Assign Teacher

actor Admin as admin
participant "Frontend" as fe
participant "ClassController" as ctrl
participant "ClassUsecase" as uc
participant "ClassRepository" as repo
database "Database" as db

admin -> fe : Chọn Học sinh & Giáo viên thêm vào Lớp ABC
activate fe
fe -> ctrl : POST /api/v1/classes/{classId}/enroll {student_ids, teacher_id}
activate ctrl

ctrl -> uc : EnrollStudentsAndAssignTeacher(ctx, req)
activate uc

uc -> repo : GetClassCapacityAndCurrentCount(classId)
activate repo
repo -> db : SELECT COUNT(*) FROM class_students
db --> repo : Trả về số lượng hiện tại
repo --> uc : Trả về dữ liệu sĩ số
deactivate repo

alt Vượt quá Sức chứa (Capacity)
    uc --> ctrl : Error "Class is full"
    ctrl --> fe : 400 Bad Request
    fe --> admin : Hiển thị lỗi Sức chứa
else Sức chứa Đảm bảo
    uc -> repo : AddStudentsToClass(classId, student_ids)
    activate repo
    repo -> db : BATCH INSERT INTO class_students
    db --> repo : Success
    deactivate repo

    uc -> repo : AssignTeacherToClass(classId, teacher_id)
    activate repo
    repo -> db : UPDATE classes SET teacher_id = ?
    db --> repo : Success
    deactivate repo
    
    uc --> ctrl : OK
    ctrl --> fe : 200 OK
    fe --> admin : Thông báo Cập nhật thành công
end

deactivate uc
deactivate ctrl
deactivate fe
@enduml
