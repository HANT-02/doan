@startuml 02_teacher_crud_admin
/'
MÔ TẢ SƠ ĐỒ
Mục tiêu: Minh hoạ chuỗi xử lý tạo mới/chỉnh sửa một Giáo viên bởi Admin.
Phạm vi: Frontend gọi API tạo Giáo viên, đi qua các layer của Clean Architecture (Controller -> Usecase -> Repo).
Assumptions:
- Admin đã đăng nhập thành công.
- Middleware Authorize đã được tích hợp để chặn các request trái phép.
'/

title Sequence Diagram - 02. Admin Create/Update Teacher

actor Admin as admin
participant "Frontend\n(React Admin)" as fe
participant "TeacherController\n(Delivery)" as ctrl
participant "AuthMiddleware" as mw
participant "TeacherUsecase\n(Business Logic)" as uc
participant "TeacherRepository\n(Data Layer)" as repo
database "Database\n(PostgreSQL)" as db

admin -> fe : Điền Form tạo mới/Sửa Giáo viên
activate fe

fe -> ctrl : POST/PUT /api/v1/teachers (Kèm Bearer Token)
activate ctrl

ctrl -> mw : Kiểm tra Token & Quyền (Role=Admin)
activate mw
mw --> ctrl : Pass (Authorized)
deactivate mw

ctrl -> uc : CreateTeacher(ctx, requestPayload)
activate uc

uc -> uc : Validate data (Email, Phone, Số giờ dạy...)
alt Validate Thất bại
    uc --> ctrl : Trả về Validation Error
    ctrl --> fe : 400 Bad Request
    fe --> admin : Hiển thị lỗi Form
else Validate Thành công
    uc -> repo : Insert/Update Teacher Entity
    activate repo
    
    repo -> db : BEGIN TRANSACTION
    activate db
    repo -> db : INSERT/UPDATE INTO users (nếu tạo account kèm)
    repo -> db : INSERT/UPDATE INTO teachers
    repo -> db : COMMIT TRANSACTION
    db --> repo : Result (Success/Fail)
    deactivate db
    
    repo --> uc : Trả về Teacher Data
    deactivate repo
    
    uc --> ctrl : Teacher Response DTO
    ctrl --> fe : 201 Created / 200 OK
    fe --> admin : Hiển thị thông báo Thành công & Cập nhật bảng
end

deactivate uc
deactivate ctrl
deactivate fe

@enduml
