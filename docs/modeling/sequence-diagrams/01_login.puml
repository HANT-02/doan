@startuml 01_login
/'
MÔ TẢ SƠ ĐỒ
Mục tiêu: Đặc tả luồng Đăng nhập (Authentication Flow) sử dụng JWT.
Phạm vi: Người dùng nhập tài khoản, mật khẩu trên Frontend, gọi đến Backend và nhận về Token.
Assumptions:
- Sử dụng Bearer Token (JWT Access Token & Refresh Token).
- Frontend lưu thông tin token vào localStorage/sessionStorage.
'/

title Sequence Diagram - 01. Login Flow

actor User as user
participant "Frontend\n(React App)" as fe
participant "AuthController\n(Delivery Layer)" as ctrl
participant "AuthUsecase\n(Business Logic)" as uc
participant "UserRepository\n(Data Layer)" as repo
database "Database\n(PostgreSQL)" as db

user -> fe : Nhập Username & Password
activate fe
fe -> ctrl : POST /api/v1/auth/login {username, password}
activate ctrl

ctrl -> uc : Login(ctx, req)
activate uc

uc -> repo : GetUserByUsername(username)
activate repo
repo -> db : SELECT * FROM users WHERE username = ?
activate db
db --> repo : Trả về dữ liệu User (kèm Hash Password)
deactivate db
repo --> uc : User Entity
deactivate repo

alt Nếu User không tồn tại hoặc sai Password
    uc --> ctrl : Trả về lỗi Unauthorized (401)
    ctrl --> fe : Lỗi "Sai tài khoản hoặc mật khẩu"
    fe --> user : Hiển thị thông báo lỗi
else Mật khẩu hợp lệ
    uc -> uc : Generate JWT (AccessToken, RefreshToken)
    uc --> ctrl : Trả về AuthTokens
    ctrl --> fe : 200 OK {access_token, refresh_token, user_info}
    fe -> fe : Lưu Tokens vào localStorage/Cookies
    fe --> user : Redirect tới Dashboard (tuỳ Role)
end

deactivate uc
deactivate ctrl
deactivate fe

@enduml
