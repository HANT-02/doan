@startuml 03_scheduling
/'
MÔ TẢ SƠ ĐỒ
Mục tiêu: Mô hình hóa cấu trúc Classes cho thuật toán Xếp lịch tự động bằng Constraint Satisfaction Problem (CSP).
Phạm vi: Các khái niệm cơ bản của CSP như Variable, Domain, Constraint và class giải thuật BacktrackingSolver.
Assumptions:
- Mẫu Strategy Design Pattern dùng cho Heuristics và Constraints để dễ mở rộng.
- Việc tính điểm SoftConstraintScorer giúp tối ưu hóa thuật toán.
'/

title Class Diagram - Scheduling CSP Model

interface Constraint {
  + evaluate(assignment: Assignment): Boolean
}

class HardConstraint implements Constraint {
  + check_teacher_conflict(): Boolean
  + check_room_conflict(): Boolean
  + check_capacity(): Boolean
  + check_after_22h_rule(): Boolean
}

class SoftConstraint implements Constraint {
  + evaluate(assignment: Assignment): Boolean
}

class SoftConstraintScorer {
  + calculatePenalty(assignment: Assignment): Int
  + prefer_consecutive_sessions(): Int
  + avoid_long_gaps(): Int
}

interface Heuristic {
  + selectNext(variables, assignment): Variable
}

class MRVHeuristic implements Heuristic {
  + selectNext(variables, assignment): Variable
}

class LCVHeuristic {
  + orderValues(variable, domain, assignment): List<DomainValue>
}

class Variable {
  + id : String
  + class_id : UUID
  + required_hours : Int
}

class DomainValue {
  + time_slot_id : UUID
  + room_id : UUID
  + teacher_id : UUID
}

class Domain {
  + values : Set<DomainValue>
  + removeValue(val: DomainValue)
}

class Assignment {
  + var_values : Map<Variable, DomainValue>
  + isComplete(): Boolean
  + getViolations(): List<String>
}

class ForwardChecking {
  + pruneDomains(var, val, unassigned_vars): Map<Variable, List<DomainValue>>
  + restoreDomains(pruned_data)
}

class BacktrackingSolver {
  + variables : List<Variable>
  + domains : Map<Variable, Domain>
  + constraints : List<Constraint>
  + current_best : Assignment
  
  + solve() : Assignment
  - backtrack(assignment) : Boolean
}

' Relationships
Variable "1" *-- "1" Domain : has
BacktrackingSolver "1" *-- "0..*" Variable : manages
BacktrackingSolver "1" *-- "0..*" Constraint : uses
BacktrackingSolver o-- Heuristic : strategy
BacktrackingSolver *-- ForwardChecking : uses
Assignment "1" *-- "0..*" Variable : maps to DomainValue
SoftConstraintScorer --> Assignment : scores

@enduml
